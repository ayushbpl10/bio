# Copy to .env on your GCP VM (never commit real secrets to git)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Allowed frontend origin for CORS
ALLOWED_ORIGIN=https://ayushbpl10.github.io

# Bind port behind Caddy TLS reverse proxy (0.0.0.0 required when Caddy runs in Docker)
PORT=8787
HOST=0.0.0.0

# Free Gmail SMTP notification to ayushbpl10@gmail.com (create an App Password in Google Account -> Security)
BOOKING_NOTIFY_EMAIL=ayushbpl10@gmail.com
GMAIL_USER=ayushbpl10@gmail.com
GMAIL_APP_PASSWORD=

# Free Google Calendar + automatic Google Meet creation (run `node get-google-token.mjs` once)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Optional static fallback Google Meet link if Calendar OAuth is not configured
STATIC_MEET_URL=

# Private 50% discount invite code (never expose in frontend source)
DISCOUNT_CODE=
